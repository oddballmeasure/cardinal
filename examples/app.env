# Environment for an app that reports its errors to Cardinal. With Docker Compose, put these in the
# shell or an .env file next to compose.yaml; the test repo's compose.yaml passes them to the API.
# Leave CARDINAL_INGEST_URL empty to turn reporting off.
CARDINAL_INGEST_URL=http://host.docker.internal:8787/v1/records
CARDINAL_INGEST_TOKEN=change-me          # must equal the value of the variable named by [ingest] token_env
CARDINAL_SOURCE_REPO=oddballmeasure/cardinal_test_repo   # must be a [[repos]] slug, or records are rejected
